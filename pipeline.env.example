# ===========================================================================
# pipeline.env.example — every secret / URL / account value as a named var.
#
# Copy to `pipeline.env` (gitignored) and fill in. scripts/lib/common.sh
# auto-sources pipeline.env. NOTHING here is committed with a real value.
#
# Security (HANDOFF §8): secrets ONLY via env; never in committed files.
# smoke.sh asserts (a) every secret referenced by the scripts appears here
# with a comment, and (b) no real-looking secret is committed anywhere.
# ===========================================================================

# --------------------------------- Models ---------------------------------
# services/models/models.py: LLM provider abstraction.
# Backend auto-selected from whichever keys are present; override with
# MODELS_BACKEND=litellm|anthropic|huggingface|cli

# Force a specific backend (optional; leave blank for auto-detection).
MODELS_BACKEND=

# --------------------------------- Intake ---------------------------------
# gh-intake.sh: source issues for the pipeline from a ProjectV2 board or repo.
# Set one of INTAKE_PROJECT or INTAKE_REPO; if neither is set, gh-intake falls
# back to PIPELINE_REPO (repo mode).

# GitHub ProjectV2 to query: ORG/PROJECT_NUMBER (e.g. ReclaimByDesign/5).
INTAKE_PROJECT=

# GitHub repo to query when not using a project board.
# Falls back to PIPELINE_REPO when unset.
INTAKE_REPO=

# Filter project items by Status field value (regex, case-insensitive).
# Example: "Triage" matches "Triage / Unscheduled".  Empty = include all.
INTAKE_STATUS_FILTER=

# Filter repo issues by label. Empty = no label filter.
INTAKE_LABEL_FILTER=

# Max items to fetch per intake run (default: 50).
INTAKE_LIMIT=50

# Test seams (like PIPELINE_FIXTURE_ISSUES for dispatch.sh).
# INTAKE_FIXTURE_PROJECT=scripts/fixtures/project-items-raw.json
# INTAKE_FIXTURE_REPO=

# --------------------------- Core pipeline knobs ---------------------------

# Master safety switch. 1 = print intended actions, mutate nothing (DEFAULT).
# Flip to 0 ONLY once pairing/branch-protection/keys are in place (§8).
PIPELINE_DRY_RUN=1

# Target repository for all gh calls, as "owner/repo". Empty => gh's default
# (the repo of the current working directory).
PIPELINE_REPO=Mendo-AI-Consulting/dispatch

# Classifier confidence gate. Issues below this are labelled needs-human (§5.1).
PIPELINE_CONFIDENCE_THRESHOLD=0.55

# Max simultaneously-claimed issues. v0 is strictly 1 (§2 deferred: parallel).
PIPELINE_CONCURRENCY=1

# Single-host tick mutex (E1-1). Overlapping cron ticks serialize on this
# flock'd lockfile so they can't double-claim a queued issue. Default path is
# repo-scoped under TMPDIR; leave blank to use the default. The committed
# scheduler examples (examples/dispatch.crontab, examples/dispatch.launchd.plist;
# see README "Scheduling unattended ticks") rely on this lock.
DISPATCH_LOCK_FILE=

# Lock-contention behaviour: 0 = non-blocking (a second concurrent tick logs
# and exits 0 without claiming anything); a positive integer waits that many
# seconds for the lock (flock -w). Default 0.
DISPATCH_LOCK_WAIT=0

# Per-tick run record / heartbeat (E1-2). pipeline.sh writes one `started` and
# one `ended` key=value line per tick to this file, INSIDE the E1-1 lock:
#   event=started tick_id=<id> ts=<ISO-8601 UTC> repo=<owner/repo> dry_run=<0|1>
#   event=ended   tick_id=<id> ts=<ISO-8601 UTC> status=<rc> claimed_count=<n> claimed=<csv> reaped_count=<n> reaped=<csv>
# The record is ALWAYS written (even in dry-run) and never calls gh. A crashed
# tick leaves a `started` with no matching success `ended` — the signal the
# reaper (E1-3) and the E4 JSONL run-ledger key off. The format is stable; E4
# parses it without changes here. Default: ${DISPATCH_ARTIFACTS_DIR:-.dispatch}/run-record.log.
DISPATCH_RUN_RECORD=

# Crash reaper (E1-3). At the top of each tick — inside the E1-1 lock, before
# claiming — the reaper re-queues issues stuck in `claimed` past the timeout with
# NO open PR (recovery from an engineer/dispatch crash that left an issue claimed
# with no Invoice and no PR). Recovery only (D1): claimed -> queued + a provenance
# comment; it never opens, escalates, or re-dispatches. Reaped issues are listed
# in the run-record above (reaped_count/reaped).
#   DISPATCH_REAPER_ENABLED      1 (default) = on; 0 disables the reaper step.
#   DISPATCH_CLAIM_TIMEOUT_HOURS stuck threshold in hours. Empty (default) =>
#                                recovery.reaper_timeout_hours in services/tuning.json
#                                (the operator decision for #49), then 4h.
DISPATCH_REAPER_ENABLED=1
DISPATCH_CLAIM_TIMEOUT_HOURS=

# DISPATCH_TICK_ID — stable id minted once per tick by pipeline.sh and exported
# to every child stage (shared with the E2-1 artifact dump). Leave unset; set
# only to pin a tick id in tests. Default: tick-<UTC-compact-timestamp>.
# DISPATCH_TICK_ID=

# DISPATCH_LEDGER_FILE — append-only JSONL run-ledger sink (E4/#36): one line per
# stage transition (tick_id, issue, stage, cost.*, label_before/after, timestamp,
# dry_run). Always written (even in dry-run), never calls gh. Default:
# ${DISPATCH_ARTIFACTS_DIR:-./.artifacts}/run-ledger.jsonl.
DISPATCH_LEDGER_FILE=

# ----------------------------- Budget oracle (E5/#38) ----------------------
# The usage-limit oracle (services/budget/oracle.py) answers "how close is the
# current 5h rolling window to the plan cap?". Per decision D2 it does NOT
# re-implement usage tracking: in production it consumes `claude-monitor`
# (Claude-Code-Usage-Monitor — `pip install claude-monitor`), an EXTERNAL RUNTIME
# DEPENDENCY (not a committed secret) that reads Claude Code's local ~/.claude
# session JSONL. Plan tier / caps / soft-cap fraction are committed in
# services/tuning.json (budget.window + budget.plan_limits).
#
# BUDGET_ORACLE_FIXTURE — offline TEST SUBSTITUTE: point at a window-state JSON
# (e.g. services/budget/fixtures/window-state.under-cap.json) and the oracle reads
# that fixture instead of claude-monitor — no subprocess, no network, no ~/.claude
# read. Leave unset in production (then the live claude-monitor path is used).
# BUDGET_ORACLE_FIXTURE=
# CLAUDE_MONITOR_BIN=claude-monitor   # override the monitor binary name/path

# Where worker sessions create git worktrees for isolation (§5.4 step 3).
PIPELINE_WORKTREE_ROOT=./.worktrees

# How workflow args reach `claude`. "prompt" embeds JSON in the prompt (the
# current documented form — there is no --args flag yet); "flag" uses --args
# for when/if that ships. See OPEN-QUESTIONS.md.
CLAUDE_ARGS_MODE=prompt

# --------------------------- Tool binary overrides -------------------------
# Usually leave blank to use PATH. Provided so odd environments still work.
GH_BIN=gh
CLAUDE_BIN=claude
OPENCLAW_BIN=openclaw
PYTHON_BIN=python3
FLOCK_BIN=flock

# ----------------------- GitHub tokens (fine-grained) ----------------------
# §8: one fine-grained PAT per stage, least privilege. NO actor may merge;
# branch protection (CI + 1 review) is the only merge path.

# Fallback / generic token (used if a stage-specific token is unset).
GITHUB_TOKEN=

# Triage/dispatch: READ-ONLY (issues:read). Quarantine reader of issue text.
TRIAGE_GITHUB_TOKEN=

# Worker: contents:write + pull_requests:write on NON-protected branches only.
# Cannot push to main, cannot merge.
WORKER_GITHUB_TOKEN=

# Closure: pull_requests:write (enable auto-merge, comment). Cannot bypass
# branch protection; auto-merge still waits on the human approval tap.
CLOSURE_GITHUB_TOKEN=

# ----------------------- HF Inference API (classifier) ---------------------
# §5.3 v0: zero-shot NLI via the serverless Inference API.
HF_TOKEN=

# Zero-shot NLI model id served by the Inference API.
HF_INFERENCE_MODEL=facebook/bart-large-mnli

# Inference API base URL (override for dedicated/Inference Endpoints).
HF_API_URL=https://api-inference.huggingface.co

# ------------------------- LiteLLM model plane -----------------------------
# §5.2: the proxy is already running; these point the pipeline at it.
LITELLM_CONFIG=./config/litellm.pipeline.yaml
LITELLM_BASE_URL=http://127.0.0.1:4000
LITELLM_MASTER_KEY=

# Anthropic key behind gen-default / gen-frontier / haiku-tier / critic groups.
ANTHROPIC_API_KEY=

# Anthropic model ids by tier. Kept in env (not baked into the YAML) because
# the model surface moves — set these to the current ids you intend to use.
# Include the litellm provider prefix in the value (these strings are dropped
# verbatim into litellm's `model:` field via os.environ/ substitution).
ANTHROPIC_DEFAULT_MODEL=anthropic/claude-sonnet-4-6          # gen-default
ANTHROPIC_FRONTIER_MODEL=anthropic/<opus-tier-model-id>      # gen-frontier (fill in)
ANTHROPIC_HAIKU_MODEL=anthropic/claude-haiku-4-5-20251001    # haiku-tier

# Local MLX Qwen3-Coder OpenAI-compatible endpoint (triage/distill/gen-local).
MLX_QWEN_BASE_URL=http://127.0.0.1:8080/v1
MLX_QWEN_API_KEY=
MLX_QWEN_MODEL=openai/Qwen3-Coder                 # provider-prefixed model id

# Hosted open-weight stubs — activate by uncommenting in litellm config +
# supplying a key (§5.2 / §9). Stay empty in v0.
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=

# --------------------------- OpenClaw Gateway ------------------------------
# §5.1 / §8. The Gateway is the scheduler, webhook receiver, and operator I/O.

# Bind address for the Gateway. MUST be loopback or tailnet — never public.
OPENCLAW_BIND_ADDR=127.0.0.1

# Operator chat channel id (already paired) for notifications/digest.
OPENCLAW_OPERATOR_CHANNEL=

# Inbound webhook URL that notify-openclaw.yml POSTs CI/review results to.
OPENCLAW_WEBHOOK_URL=

# Bearer token guarding the inbound webhook (also set as a GitHub Actions
# secret of the same name for notify-openclaw.yml).
OPENCLAW_WEBHOOK_BEARER_TOKEN=

# Cron schedules (crontab syntax). Dispatch every 10 min; digest at 08:00.
OPENCLAW_DISPATCH_SCHEDULE="*/10 * * * *"
OPENCLAW_DIGEST_SCHEDULE="0 8 * * *"

# Cheap model alias for the daily digest agent turn (§5.1 item 3).
OPENCLAW_MODEL_CHEAP=haiku-tier

# ===========================================================================
# Test seams — consulted ONLY when set; never needed in production. smoke.sh
# sets these to drive scripts offline. Listed here for documentation; leave
# blank/unset in real deployments.
# ===========================================================================
# PIPELINE_FIXTURE_ISSUES=   # path to a JSON array of queued issues (dispatch)
# PIPELINE_FIXTURE_PR=       # path to a JSON object describing a PR (fix/closure)
# PIPELINE_FIX_ATTEMPT=      # explicit fix-ladder attempt override
# CLASSIFIER_OFFLINE=        # 1 => deterministic offline classifier (no network)
