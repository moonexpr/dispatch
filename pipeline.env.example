# ===========================================================================
# pipeline.env.example — every secret / URL / account value as a named var.
#
# Copy to `pipeline.env` (gitignored) and fill in. scripts/lib/common.sh
# auto-sources pipeline.env. NOTHING here is committed with a real value.
#
# Security (HANDOFF §8): secrets ONLY via env; never in committed files.
# smoke.sh asserts (a) every secret referenced by the scripts appears here
# with a comment, and (b) no real-looking secret is committed anywhere.
# ===========================================================================

# --------------------------- Core pipeline knobs ---------------------------

# Master safety switch. 1 = print intended actions, mutate nothing (DEFAULT).
# Flip to 0 ONLY once pairing/branch-protection/keys are in place (§8).
PIPELINE_DRY_RUN=1

# Target repository for all gh calls, as "owner/repo". Empty => gh's default
# (the repo of the current working directory).
PIPELINE_REPO=Mendo-AI-Consulting/dispatch

# Classifier confidence gate. Issues below this are labelled needs-human (§5.1).
PIPELINE_CONFIDENCE_THRESHOLD=0.55

# Max simultaneously-claimed issues. v0 is strictly 1 (§2 deferred: parallel).
PIPELINE_CONCURRENCY=1

# Where worker sessions create git worktrees for isolation (§5.4 step 3).
PIPELINE_WORKTREE_ROOT=./.worktrees

# How workflow args reach `claude`. "prompt" embeds JSON in the prompt (the
# current documented form — there is no --args flag yet); "flag" uses --args
# for when/if that ships. See OPEN-QUESTIONS.md.
CLAUDE_ARGS_MODE=prompt

# --------------------------- Tool binary overrides -------------------------
# Usually leave blank to use PATH. Provided so odd environments still work.
GH_BIN=gh
CLAUDE_BIN=claude
OPENCLAW_BIN=openclaw
PYTHON_BIN=python3

# ----------------------- GitHub tokens (fine-grained) ----------------------
# §8: one fine-grained PAT per stage, least privilege. NO actor may merge;
# branch protection (CI + 1 review) is the only merge path.

# Fallback / generic token (used if a stage-specific token is unset).
GITHUB_TOKEN=

# Triage/dispatch: READ-ONLY (issues:read). Quarantine reader of issue text.
TRIAGE_GITHUB_TOKEN=

# Worker: contents:write + pull_requests:write on NON-protected branches only.
# Cannot push to main, cannot merge.
WORKER_GITHUB_TOKEN=

# Closure: pull_requests:write (enable auto-merge, comment). Cannot bypass
# branch protection; auto-merge still waits on the human approval tap.
CLOSURE_GITHUB_TOKEN=

# ----------------------- HF Inference API (classifier) ---------------------
# §5.3 v0: zero-shot NLI via the serverless Inference API.
HF_TOKEN=

# Zero-shot NLI model id served by the Inference API.
HF_INFERENCE_MODEL=facebook/bart-large-mnli

# Inference API base URL (override for dedicated/Inference Endpoints).
HF_API_URL=https://api-inference.huggingface.co

# ------------------------- LiteLLM model plane -----------------------------
# §5.2: the proxy is already running; these point the pipeline at it.
LITELLM_CONFIG=./config/litellm.pipeline.yaml
LITELLM_BASE_URL=http://127.0.0.1:4000
LITELLM_MASTER_KEY=

# Anthropic key behind gen-default / gen-frontier / haiku-tier / critic groups.
ANTHROPIC_API_KEY=

# Anthropic model ids by tier. Kept in env (not baked into the YAML) because
# the model surface moves — set these to the current ids you intend to use.
# Include the litellm provider prefix in the value (these strings are dropped
# verbatim into litellm's `model:` field via os.environ/ substitution).
ANTHROPIC_DEFAULT_MODEL=anthropic/claude-sonnet-4-6          # gen-default
ANTHROPIC_FRONTIER_MODEL=anthropic/<opus-tier-model-id>      # gen-frontier (fill in)
ANTHROPIC_HAIKU_MODEL=anthropic/claude-haiku-4-5-20251001    # haiku-tier

# Local MLX Qwen3-Coder OpenAI-compatible endpoint (triage/distill/gen-local).
MLX_QWEN_BASE_URL=http://127.0.0.1:8080/v1
MLX_QWEN_API_KEY=
MLX_QWEN_MODEL=openai/Qwen3-Coder                 # provider-prefixed model id

# Hosted open-weight stubs — activate by uncommenting in litellm config +
# supplying a key (§5.2 / §9). Stay empty in v0.
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=

# --------------------------- OpenClaw Gateway ------------------------------
# §5.1 / §8. The Gateway is the scheduler, webhook receiver, and operator I/O.

# Bind address for the Gateway. MUST be loopback or tailnet — never public.
OPENCLAW_BIND_ADDR=127.0.0.1

# Operator chat channel id (already paired) for notifications/digest.
OPENCLAW_OPERATOR_CHANNEL=

# Inbound webhook URL that notify-openclaw.yml POSTs CI/review results to.
OPENCLAW_WEBHOOK_URL=

# Bearer token guarding the inbound webhook (also set as a GitHub Actions
# secret of the same name for notify-openclaw.yml).
OPENCLAW_WEBHOOK_BEARER_TOKEN=

# Cron schedules (crontab syntax). Dispatch every 10 min; digest at 08:00.
OPENCLAW_DISPATCH_SCHEDULE=*/10 * * * *
OPENCLAW_DIGEST_SCHEDULE=0 8 * * *

# Cheap model alias for the daily digest agent turn (§5.1 item 3).
OPENCLAW_MODEL_CHEAP=haiku-tier

# ===========================================================================
# Test seams — consulted ONLY when set; never needed in production. smoke.sh
# sets these to drive scripts offline. Listed here for documentation; leave
# blank/unset in real deployments.
# ===========================================================================
# PIPELINE_FIXTURE_ISSUES=   # path to a JSON array of queued issues (dispatch)
# PIPELINE_FIXTURE_PR=       # path to a JSON object describing a PR (fix/closure)
# PIPELINE_FIX_ATTEMPT=      # explicit fix-ladder attempt override
# CLASSIFIER_OFFLINE=        # 1 => deterministic offline classifier (no network)
