<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  dispatch — example launchd agent for unattended ticks on macOS (issue #29).
  The macOS counterpart of examples/dispatch.crontab.

  Install (edit paths + repo first):
      cp examples/dispatch.launchd.plist ~/Library/LaunchAgents/com.dispatch.tick.plist
      launchctl load ~/Library/LaunchAgents/com.dispatch.tick.plist

  DRY-RUN IS THE DEFAULT. PIPELINE_DRY_RUN below is set to 0 EXPLICITLY to go
  live — set it to 1 to keep previewing without mutating GitHub. The pipeline's
  in-process flock (E1-1, DISPATCH_LOCK_FILE) serializes overlapping ticks, so
  no two runs double-claim a queued issue.

  Upgrade paths (NOT the 1.0 default — see README "Scheduling unattended
  ticks"): (a) OpenClaw Gateway, (c) the billy.maic VPS (existing issue #15).
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dispatch.tick</string>

    <!-- Run entrypoint.sh under bash; --repo is passed through to pipeline.sh. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/opt/dispatch/entrypoint.sh</string>
        <string>--repo</string>
        <string>owner/your-repo</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/opt/dispatch</string>

    <!-- Explicit env: target repo + the deliberate live flag (default is dry-run). -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PIPELINE_REPO</key>
        <string>owner/your-repo</string>
        <key>PIPELINE_DRY_RUN</key>
        <string>0</string>
    </dict>

    <!-- 4x/day at 00:07, 06:07, 12:07, 18:07 (launchd's StartCalendarInterval). -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>0</integer><key>Minute</key><integer>7</integer></dict>
        <dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>7</integer></dict>
        <dict><key>Hour</key><integer>12</integer><key>Minute</key><integer>7</integer></dict>
        <dict><key>Hour</key><integer>18</integer><key>Minute</key><integer>7</integer></dict>
    </array>

    <key>StandardOutPath</key>
    <string>/opt/dispatch/dispatch.cron.log</string>
    <key>StandardErrorPath</key>
    <string>/opt/dispatch/dispatch.cron.log</string>
</dict>
</plist>
