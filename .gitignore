# Secrets live ONLY in env (HANDOFF §8) — never commit the filled-in file.
pipeline.env
tokens.txt

# Worker session worktrees (isolation; transient).
.worktrees/
# Default per-tick run-record / heartbeat sink (E1-2); regenerable each tick.
.dispatch/
# Default run-ledger sink (E4/#36) when DISPATCH_ARTIFACTS_DIR is unset; regenerable.
.artifacts/
# Claude Code session worktrees (transient).
.claude/worktrees/
# Local clone of the GitHub wiki for authoring (.claude/wiki is its own git repo).
.claude/wiki/
# Generated dispatch artifacts (e.g. the static issue DAG — regenerable via ./dispatch --dag).
.claude/artifacts/
# Demo harness per-round output (E8-3 replay.sh); snapshots/scenarios/seed ARE committed, only rounds/ is transient.
scripts/demo/rounds/
# Stray ruflo runtime state under src/ (NOT the tracked root .claude-flow/ config).
src/.claude-flow/
# RealActionFactory FileShelf sink (durable shelves; regenerable each run, e.g. run_live/test_e2e).
app/actions/

# Python / tooling noise
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/

# Transient run/test output
test_results.txt

# Editor / OS
.DS_Store
*.swp


# claude framework (personal methods)
WORKPLAN.md
.claude/agents/
CLAUDE.local.md

# ruflo/.claude-flow runtime — no longer tracked; ignore the whole dir
.claude-flow/
# local test-run finding drafts (the GitHub issue comments are the durable record)
scripts/demo/testrun-findings/
