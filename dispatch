#!/usr/bin/env python3
"""dispatch — the entrypoint: bootstrap the environment, then route to a runtime engine.

This file is the kernel's composition root. It does two things and no domain work:

  1. **Bootstrap** — line-buffer stdout/stderr, put the repo on ``sys.path`` /
     ``PYTHONPATH``, load ``.env`` (then the legacy ``pipeline.env``) for local secrets,
     and default the model backend to the ``claude`` CLI (subscription auth).
  2. **Route** — parse the request into a :class:`foundation.kernel.session.BootSpec` and
     hand it to the right :class:`~foundation.kernel.session.Session`: the concrete
     ``AdhocSession`` (run one tick, then terminate) today; the daemon runtime is
     interface-only (``TODO(John)``).

The interfaces live in ``foundation.kernel`` (contracts only); the concrete engines live
in the repo-root ``kernel/`` package. The legacy orchestration visitor-pattern tick is
retired — the workflow engine is the single execution layer.

  python3 dispatch -r OWNER/REPO [ISSUE] [-l/--live] [-v] [--daemon] [-h/--help]

  -r/--repo OWNER/REPO   target repo (or $PIPELINE_REPO)
  ISSUE                  issue number (default: the first open issue)
  -l/--live              PIPELINE_DRY_RUN=0 — mutate GitHub (default: dry-run)
  --daemon               route to the long-lived daemon runtime (TODO(John): stub)
  DISPATCH_ENGINE        baseworkflow (default) | websitewf
"""
from __future__ import annotations

import os
import sys

_ROOT = os.path.dirname(os.path.abspath(__file__))

# --- Bootstrap -------------------------------------------------------------
# Line-buffer stdout/stderr so a long live tick streams progress in real time even when
# redirected to a file (Python block-buffers non-TTY streams otherwise).
for _stream in (sys.stdout, sys.stderr):
    try:
        _stream.reconfigure(line_buffering=True)
    except (AttributeError, ValueError):
        pass

os.environ.setdefault("PYTHONDONTWRITEBYTECODE", "1")
os.environ["PYTHONPATH"] = _ROOT + (
    os.pathsep + os.environ["PYTHONPATH"] if os.environ.get("PYTHONPATH") else ""
)
if _ROOT not in sys.path:
    sys.path.insert(0, _ROOT)

# Local secrets + overrides (GITIGNORED): ``.env`` first, then the legacy
# ``pipeline.env``. Explicit shell env wins (the preserve list); a missing/garbled file
# must never block. e.g. CLAUDE_CODE_OAUTH_TOKEN (subscription auth), MODELS_BACKEND.
try:
    from foundation import runtime as _runtime

    _preserve = ("PIPELINE_DRY_RUN", "PIPELINE_REPO", "DISPATCH_ENGINE",
                 "MODELS_BACKEND", "CLAUDE_CODE_OAUTH_TOKEN")
    for _envfile in (".env", "pipeline.env"):
        _runtime.load_dotenv(os.path.join(_ROOT, _envfile), preserve=_preserve)
except Exception:  # noqa: BLE001 — dotenv is optional.
    pass

# Inference runs on the Claude **subscription** (Claude Code), not API billing: default
# the model backend to the ``claude -p`` CLI. Override with MODELS_BACKEND=anthropic.
os.environ.setdefault("MODELS_BACKEND", "cli")

from foundation.kernel.session import BootSpec, SessionKind  # noqa: E402  (after sys.path bootstrap)


def _usage(code: int = 0) -> int:
    print(__doc__.strip())
    return code


def _parse(argv: list) -> BootSpec:
    repo = os.environ.get("PIPELINE_REPO", "")
    live = False
    issue = None
    kind = SessionKind.ADHOC
    verbose = os.environ.get("DISPATCH_DEBUG") not in (None, "", "0")
    engine = os.environ.get("DISPATCH_ENGINE", "baseworkflow")
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("-h", "--help"):
            raise SystemExit(_usage(0))
        elif a in ("-l", "--live"):
            live = True
        elif a in ("-v", "--verbose"):
            verbose = True
        elif a == "--daemon":
            kind = SessionKind.DAEMON
        elif a in ("-r", "--repo"):
            i += 1
            repo = argv[i]
        elif a.isdigit():
            issue = int(a)
        else:
            print(f"dispatch: unknown argument {a!r}\n", file=sys.stderr)
            raise SystemExit(_usage(2))
        i += 1
    if not repo and kind is SessionKind.ADHOC:
        print("dispatch: a repo is required (-r OWNER/REPO or $PIPELINE_REPO)\n", file=sys.stderr)
        raise SystemExit(_usage(2))
    return BootSpec(repo=repo, issue=issue, live=live, verbose=verbose, engine=engine, kind=kind)


def main(argv: list) -> int:
    spec = _parse(argv)
    if spec.kind is SessionKind.DAEMON:
        # TODO(John): route to a concrete DaemonSession once one exists under kernel/.
        # The interface lives at foundation.kernel.daemon.DaemonSession (web-server stub).
        print("dispatch: daemon runtime not implemented yet — TODO(John)", file=sys.stderr)
        return 2
    from kernel.adhoc_session import AdhocSession

    return AdhocSession(spec).run()


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
