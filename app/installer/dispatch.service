# dispatch.service — one unattended LIVE engineering tick (Linux / systemd).
#
# Install as a USER unit (no root needed):
#   mkdir -p ~/.config/systemd/user
#   cp app/installer/dispatch.service app/installer/dispatch.timer ~/.config/systemd/user/
#   # edit ExecStart below if the repo is not at the path shown
#   systemctl --user daemon-reload
#   systemctl --user enable --now dispatch.timer
#   systemctl --user list-timers dispatch.timer     # confirm the schedule
#   journalctl --user -u dispatch.service -f         # watch a tick
#
# Triggered by dispatch.timer (every 2h = 12x/day). Type=oneshot: each tick runs
# to completion and exits; the timer fires the next one.
[Unit]
Description=dispatch — one unattended live engineering tick
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Repo location on the deploy host (WORKSTATION default shown — adjust if elsewhere):
ExecStart=%h/dispatch/app/installer/dispatch-tick.sh
# A live tick clones, runs the agent, and pushes — give it room; never hang forever:
TimeoutStartSec=2400
Nice=10
