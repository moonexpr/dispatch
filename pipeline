#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# pipeline — single entrypoint for the Unattended Engineering Pipeline (v0).
#
# The orchestration layer lives in the src/orchestration Python package
# (visitor-pattern stages). This is the one launcher; the former per-stage
# scripts/*.sh shims are gone — inspect a single component via `devtools`.
#
#   ./pipeline [FLAGS]                 run a full tick
#       -b/--bootstrap -r/--repo -l/--live -e/--engineer -f/--fixture
#       -u/--until --from -a/--artifact -h/--help
#
#   ./pipeline devtools <component> …  inspect/run ONE pipeline component:
#       dispatch | intake-invoice | closure | fix | intake | labels |
#       prep | engineer
#
# stdin, env vars (or pipeline.env) and exit codes pass through unchanged, so
# every former `bash scripts/<x>.sh` caller maps onto `./pipeline …`.
# ---------------------------------------------------------------------------
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec env PYTHONDONTWRITEBYTECODE=1 PYTHONPATH="${ROOT}${PYTHONPATH:+:${PYTHONPATH}}" \
  "${PYTHON_BIN:-python3}" -m src.orchestration "$@"
