{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Bash(git:*)",
      "Bash(npm:*)",
      "Bash(node:*)",
      "Bash(npx:*)",
      "Bash(python3:*)",
      "Bash(claude:*)",
      "Bash(mkdir:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(find:*)"
    ],
    "deny": [
      "Read(.env)",
      "Write(.env)",
      "Edit(.env)",
      "Read(.env.*)",
      "Write(.env.*)",
      "Edit(.env.*)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(Secrets/**)",
      "Read(Credentials/**)"
    ]
  }
}